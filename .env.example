# RefleK's app optional environment overrides
# Copy this file to $HOME/.refleks/.env on Windows or to the current working directory during development.
# Values from real environment variables take precedence over .env.

# Fallback SteamID64 used when the app cannot read Steam's loginusers.vdf
# Example: REFLEKS_STEAM_ID=84609298453789401
REFLEKS_STEAM_ID=

# Fallback Steam PersonaName used when the app cannot read Steam's loginusers.vdf
# Example: REFLEKS_PERSONA_NAME=YourSteamName
REFLEKS_PERSONA_NAME=

# Default KovaaK's install directory (used primarily in dev)
# The app resolves stats and performances under FPSAimTrainer/ inside this folder.
# Example for a Windows install:
# REFLEKS_KOVAAKS_INSTALL_DIR=C:/Program Files (x86)/Steam/steamapps/common/FPSAimTrainer
REFLEKS_KOVAAKS_INSTALL_DIR=

# Optional cloud run sync endpoint override.
# If empty, the app uses its built-in default endpoint.
# Example:
# REFLEKS_RUNS_SYNC_URL=https://api.refleksapp.com/v1/runs/sync
REFLEKS_RUNS_SYNC_URL=
